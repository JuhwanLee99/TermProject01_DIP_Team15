# Build artifacts
# 운영체제 및 컴파일러에 따라 생성되는 빌드 결과물
*.o
*.obj
*.exe
*.out
*.app
*.dll
*.so
*.dylib
*.lib
*.a

# Executable name from the previous example
# 예제에서 사용한 실행 파일 이름
shape_classifier

# Build directories
# 빌드 과정에서 생성되는 폴더
build/
bin/
Debug/
Release/

# IDE and editor configuration files
# 각종 IDE 및 에디터 관련 설정 파일
.vs/
.vscode/
.idea/
*.suo
*.user
*.vcxproj.user
*.vcxproj.filters

# macOS specific files
# macOS 운영체제 자동 생성 파일
.DS_Store

# Windows specific files
# Windows 운영체제 자동 생성 파일
Thumbs.db